# Google OAuth (https://console.cloud.google.com/apis/credentials -> OAuth client ID, Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Comma-separated emails that get Admin Lead access. Everyone else is a Team Lead.
ADMIN_EMAILS=admin@yourcompany.com

# Optional: only allow this Google Workspace domain to sign in
ALLOWED_EMAIL_DOMAIN=
